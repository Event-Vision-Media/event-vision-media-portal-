# Supabase Projekt-URL und Keys (Einstellungen -> API im Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Service-Role-Key: NUR serverseitig verwendet, niemals im Client-Code!
# Wird für Buchungscode-Login und alle Admin-Aktionen benötigt (umgeht RLS).
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key
