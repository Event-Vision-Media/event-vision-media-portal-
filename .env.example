# Supabase Projekt-URL und Keys (Einstellungen -> API im Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Service-Role-Key: NUR serverseitig verwendet, niemals im Client-Code!
# Wird für Buchungscode-Login und alle Admin-Aktionen benötigt (umgeht RLS).
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ---------------------------------------------------------------------------
# Website-Anfragen & E-Mails (siehe README, Abschnitt "Website-Anfragen")
# ---------------------------------------------------------------------------
# Öffentliche Adresse dieses Kundenportals (für Links in E-Mails)
PORTAL_URL=https://portal.fotobox-essen.com
# Website-Domains, die Anfragen senden dürfen (kommagetrennt)
ALLOWED_ORIGINS=https://www.fotobox-essen.com,https://fotobox-essen.com
# Resend (https://resend.com) – API-Key und bestätigte Absenderadresse
RESEND_API_KEY=re_...
MAIL_FROM=Event Vision Media <info@fotobox-essen.com>
# Hierhin gehen die Benachrichtigungen über neue Anfragen
ADMIN_EMAIL=info@fotobox-essen.com

# Login per fortlaufendem Buchungscode (FB-2026-0001). Übergangsweise erlaubt;
# auf "false" setzen, sobald alle Kunden ihren neuen Zugangscode (EV-XXXX-XXXX) haben.
LEGACY_BOOKING_CODE_LOGIN=true

# Täglicher Automatik-Lauf (Erinnerungen & Nachher-Mails, siehe vercel.json).
# Beliebige lange Zufallszeichenkette – Vercel sendet sie automatisch mit.
CRON_SECRET=

# Website mit Impressum/Datenschutz (Links im Portal-Footer), optional
NEXT_PUBLIC_WEBSITE_URL=https://fotobox-essen.com

# Fahrtkosten: Entfernungsberechnung über openrouteservice (kostenloser Schlüssel)
ORS_API_KEY=
# Geheimer Code für das Kalender-Abo (/api/calendar?token=…), lange Zufallszeichenkette
CALENDAR_FEED_TOKEN=
